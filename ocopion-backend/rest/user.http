@hostname = localhost
@port = 8301
@host = {{hostname}}:{{port}}

### CreateUser
post http://{{host}}/api/user HTTP/1.1
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "example-password",
  "username": "example-user",
  "nickname": "示例用户"
}

### GetUserByID
@userId = 1
get http://{{host}}/api/user/{{userId}} HTTP/1.1

### UpdateUser
put http://{{host}}/api/user/{{userId}} HTTP/1.1
Content-Type: application/json

{
  "nickname": "更新后的昵称",
  "phone": "",
  "avatarUrl": ""
}

### GetUserList
get http://{{host}}/api/user?pageNum=1&pageSize=10&keyword=example HTTP/1.1

### BatchDeleteUsers
post http://{{host}}/api/user/delete HTTP/1.1
Content-Type: application/json

{
  "ids": [1, 2]
}
